FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
COPY services/core/package.json services/core/
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY services/core/src services/core/src
RUN npm run build && npm prune --omit=dev --ignore-scripts

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg \
    && case "$(dpkg --print-architecture)" in \
      amd64) arch=x64; digest=7a3cf35ad146fd7810b4ededab363c8a3e6121d1b2c8391f53863126186f9ee6 ;; \
      arm64) arch=arm64; digest=d3a50cecc139b54435be1bbbfba5c0ea822d9e1e7edc3531f7821fba65ceebb0 ;; \
      *) exit 1 ;; esac \
    && curl -fsSL --retry 3 "https://github.com/shaka-project/shaka-packager/releases/download/v3.9.3/packager-linux-${arch}" -o /usr/local/bin/packager \
    && echo "${digest}  /usr/local/bin/packager" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/packager && packager --version \
    && apt-get purge -y --auto-remove curl && rm -rf /var/lib/apt/lists/* \
    && install -d -m 0700 -o node -g node /media/input /media/output
WORKDIR /app
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/dist dist
COPY --chown=node:node package.json ./
USER node
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=3 \
  CMD ["node","-e","try { const expiry = Number(require('node:fs').readFileSync('/tmp/openshield-worker-heartbeat','utf8')); process.exit(expiry > Date.now() ? 0 : 1); } catch { process.exit(1); }"]
CMD ["node","dist/media-worker.js"]
